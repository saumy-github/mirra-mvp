# Copy this file to .env.docker.dev — the only env file this backend uses.
# Every setting has a dev default in src/config.py, so a missing .env still
# boots against local Mongo.

# MongoDB — same mirratest database the CLO pipeline already uses
MONGODB_URI=
DATABASE_NAME=mirratest

# Auth (backend-implementation-plan.md, Phase 0 item 1)
ACCESS_TOKEN_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

# CORS — comma-separated origins; default is the Vite dev server (port 3000)
CORS_ORIGINS=http://localhost:3000

# development | production — picks dev_upload/ vs live_upload/
APP_ENV=development

# Job queue hand-off to the native CLO worker. Use the Docker service name
# (redis://redis:6379/0) for the Docker path, redis://localhost:6379/0 for
# the native path — see SETUP.md.
REDIS_URL=redis://redis:6379/0

# Google OAuth (03-backend-behavior-plan.md). Leave client id/secret blank
# to keep Google sign-in disabled (auth/google/start responds 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_FAILURE_URL=http://localhost:3000/auth/login
