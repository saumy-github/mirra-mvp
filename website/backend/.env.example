# Copy to .env and adjust. Every setting has a dev default in src/config.py,
# so a missing .env still boots against local Mongo.

# MongoDB — same mirratest database the CLO pipeline already uses
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mirratest

# Auth (backend-implementation-plan.md, Phase 0 item 1)
ACCESS_TOKEN_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

# CORS — comma-separated origins; default is the Vite dev server (port 3000)
CORS_ORIGINS=http://localhost:3000

# CLO3D engine seams: demo | live
AVATAR_ENGINE_MODE=demo
TRYON_ENGINE_MODE=demo

# Capture photo storage directory (relative to website/backend/)
UPLOADS_DIR=uploads

# Google OAuth (03-backend-behavior-plan.md). Leave client id/secret blank
# to keep Google sign-in disabled (auth/google/start responds 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback
FRONTEND_AUTH_FAILURE_URL=http://localhost:3000/auth/login

# Optional SMTP delivery for /api/v1/join acknowledgement emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mirra
SMTP_SECURITY=starttls
JOIN_NOTIFICATION_EMAIL=
