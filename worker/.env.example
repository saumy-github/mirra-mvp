# Native CLO worker environment. Copy this to worker/.env and fill in real
# values — worker/.env is gitignored (repo-root .gitignore's .env/.env.*
# rule already covers it, nothing extra to add).

# Same Atlas mirratest URI already used by website/backend/.env.dev and
# mirra_measurements/.env — the worker reads/writes avatar_jobs,
# avatar_profiles, tryon_renders in the same database.
MONGODB_URI=

# Redis, reached from this native Windows process via the port
# docker-compose publishes to the host (NOT the "redis" service name —
# that only resolves inside the Docker network the backend container is
# on). Matches docker-compose.yml's redis service (6379:6379).
REDIS_URL=redis://localhost:6379/0
