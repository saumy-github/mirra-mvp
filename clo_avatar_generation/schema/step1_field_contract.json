{
  "version": "v2-draft",
  "scope": "male_and_female",
  "unit": "cm",
  "round_decimals": 2,
  "default_base_avatar": "clo_avatar_generation/input/base-1.avt",
  "preferred_measurement_apply_mode": "auto",
  "measurement_bridge_template_csv": "clo_avatar_generation/schema/measurement_template_unconfirmed.csv",
  "human_readable_payload": "input.json",
  "preferred_clo_payload": "avs",
  "preferred_error_source": "plugin_api_readback",
  "fallback_error_source": "saved_avs_and_avt",
  "fields": [
    {
      "mongo_field": "height_cm",
      "clo_target": "Total Height",
      "property_key": "Total Height",
      "avt_feature_index": 0,
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "direct",
      "notes": "Primary height driver for v1."
    },
    {
      "mongo_field": "weight_kg",
      "clo_target": "Weight",
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "kg",
      "apply_routes": ["csv_bridge"],
      "mapping_type": "direct",
      "notes": "Primary width driver for v1. Weight remains in kg."
    },
    {
      "mongo_field": "shoulder_width_cm",
      "clo_target": "Across Shoulder (Curvilinear)",
      "property_key": "Across Shoulder (Curvilinear)",
      "avt_feature_index": 36,
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "approximate",
      "notes": "Current closest direct CLO field for shoulder width."
    },
    {
      "mongo_field": "chest_circumference_cm",
      "clo_target": "Chest",
      "property_key": "Chest",
      "avt_feature_index": 2,
      "included_in_v1": true,
      "genders": ["male"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "direct",
      "notes": "Male chest circumference maps to CLO Chest (slot 2). Female avatars use Bust in the same slot."
    },
    {
      "mongo_field": "waist_circumference_cm",
      "clo_target": "Waist",
      "property_key": "Waist",
      "avt_feature_index": 6,
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "direct",
      "notes": "Direct waist mapping."
    },
    {
      "mongo_field": "hip_circumference_cm",
      "clo_target": "Low Hip",
      "property_key": "Low Hip",
      "avt_feature_index": 8,
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "closest_direct_field",
      "notes": "Current closest CLO field to Mirra hip circumference."
    },
    {
      "mongo_field": "leg_length_cm",
      "clo_target": "Inseam",
      "property_key": "Inseam",
      "avt_feature_index": 26,
      "included_in_v1": true,
      "genders": ["male", "female"],
      "unit": "cm",
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "mapping_type": "closest_direct_field",
      "notes": "Current closest CLO field to Mirra leg length."
    },
    {
      "mongo_field": "bust_circumference_cm",
      "clo_target": "Bust",
      "included_in_v1": true,
      "genders": ["female"],
      "unit": "cm",
      "mapping_type": "assumed_shared_slot",
      "notes": "Slot 2 = CLO BustCircum (labelled Chest on male avatars). Falls back to chest_circumference_cm when a female profile has no bust value (manual entry asks for chest).",
      "property_key": "Bust",
      "avt_feature_index": 2,
      "apply_routes": ["avt_patch", "avatar_properties", "csv_bridge"],
      "required": true
    },
    {
      "mongo_field": "under_bust_circumference_cm",
      "clo_target": "Under Bust",
      "included_in_v1": true,
      "genders": ["female"],
      "unit": "cm",
      "mapping_type": "direct",
      "notes": "No known .avt slot: applied on the property/CSV routes only; ignored by avt_patch. Optional.",
      "property_key": "Under Bust",
      "apply_routes": ["avatar_properties", "csv_bridge"],
      "required": false
    }
  ],
  "out_of_scope_notes": {
    "Head/Neck": "Head and neck simplification logic is not a current target.",
    "Hands": "Hands below the wrist are not a current target.",
    "Feet": "Feet below the ankle are not a current target.",
    "Crotch Area": "Crotch realism work is not a current target."
  },
  "implementation_note": "If CLO behavior later proves sensitive to the order of value application, ordering rules will be decided at that point.",
  "base_avatars": {
    "male": "clo_avatar_generation/input/base-1.avt",
    "female": "clo_avatar_generation/input/base-female.avt"
  },
  "female_note": "Female uses CLO's stock Female V2 avatar (e.g. FV2_Feifei.avt from CLO's asset folder) copied to base_avatars.female. Slot indices are assumed shared with Male V2: both are CLO V2 avatars with the same listFeatureValues block, and slot 2 is CLO's internal BustCircum (fBaseFeatureBustCircum appears next to the block in base-1.avt). Confirm on the first female run: requested vs the .avt readback in step 09."
}
