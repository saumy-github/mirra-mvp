+	/// @enum ButtonPairEdgeOrigin
+	/// @brief Corner of the placement edge that the along-edge distances are measured from. Used by
+	/// PatternAPI::PlaceButtonPairsOnEdge / DistributeButtonPairsOnEdge through ButtonPairPlacementOption.
+	/// The 2D window Y axis points up, so TOP is the edge endpoint with the greater Y.
+	enum ButtonPairEdgeOrigin
+	{
+		EXPORT_PYTHON BUTTON_PAIR_EDGE_ORIGIN_TOP = 0,		/// Distances start at the upper corner of the edge (greater 2D-window Y)
+		EXPORT_PYTHON BUTTON_PAIR_EDGE_ORIGIN_BOTTOM = 1	/// Distances start at the lower corner of the edge (smaller 2D-window Y)
+	};
+
+	/// @struct ButtonPairPlacementOption
+	/// @brief Optional settings for PatternAPI::PlaceButtonPairsOnEdge / DistributeButtonPairsOnEdge. The default
+	/// constructor is a safe configuration: distances measured from the TOP corner, the project's current button head
+	/// and buttonhole styles, style-default buttonhole size and unrotated items.
+	struct ButtonPairPlacementOption
+	{
+		EXPORT_PYTHON ButtonPairEdgeOrigin edgeOrigin;	/// Corner the along-edge distances are measured from. Default BUTTON_PAIR_EDGE_ORIGIN_TOP
+		EXPORT_PYTHON int buttonHeadStyleIndex;			/// Button head style index (order of GetButtonHeadStyleListWithIndex). -1 (default) = the current default button head style
+		EXPORT_PYTHON int buttonholeStyleIndex;			/// Buttonhole style index. -1 (default) = the current default buttonhole style
+		EXPORT_PYTHON float buttonholeWidth;			/// Per-instance buttonhole width in mm. 0 (default) keeps the style size. Set together with buttonholeHeight
+		EXPORT_PYTHON float buttonholeHeight;			/// Per-instance buttonhole height in mm. 0 (default) keeps the style size. Set together with buttonholeWidth
+		EXPORT_PYTHON float buttonAngleDegree;			/// Rotation applied to every created button head, in degrees. Default 0
+		EXPORT_PYTHON float buttonholeAngleDegree;		/// Rotation applied to every created buttonhole, in degrees. Default 0
+
+		ButtonPairPlacementOption()
+		{
+			edgeOrigin = BUTTON_PAIR_EDGE_ORIGIN_TOP;
+			buttonHeadStyleIndex = -1;
+			buttonholeStyleIndex = -1;
+			buttonholeWidth = 0.0f;
+			buttonholeHeight = 0.0f;
+			buttonAngleDegree = 0.0f;
+			buttonholeAngleDegree = 0.0f;
+		}
+	};
