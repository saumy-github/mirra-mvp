+		/// @fn DistributeButtonPairsOnEdge(int _buttonPatternIndex, int _buttonLineIndex, int _buttonholePatternIndex, int _buttonholeLineIndex, float _edgeOffset, int _buttonCount, float _startMargin, float _endMargin, const Marvelous::ButtonPairPlacementOption& _option)
+		/// @brief Distribute _buttonCount button / buttonhole pairs evenly along the edges of two seam-paired patterns -
